#!/bin/sh
# Runs after packages are installed (inside mkosi's sandbox; mkosi-chroot
# enters the image). Creates users and enables/masks units at build time,
# because the root filesystem is read-only at runtime.
set -eu

mkosi-chroot sh -eu <<'CHROOT'
getent group render >/dev/null || groupadd -r render
getent group seat >/dev/null || groupadd -r seat
getent group netdev >/dev/null || groupadd -r netdev
id aios >/dev/null 2>&1 || useradd -u 1000 -m -d /home/aios -s /bin/sh -G video,input,render,audio,seat,netdev aios
id aiosd >/dev/null 2>&1 || useradd -r -G aios -d /nonexistent -s /usr/sbin/nologin aiosd
passwd -l aios >/dev/null

for u in seatd.service systemd-networkd.service systemd-resolved.service aios-session.service aiosd.service aios-llm.service; do
  [ -e "/usr/lib/systemd/system/$u" ] && systemctl enable "$u"
done
systemctl set-default graphical.target
for u in apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service \
         man-db.timer man-db.service e2scrub_all.timer e2scrub_reap.service \
         getty@tty1.service getty@tty2.service getty@tty3.service getty@tty4.service \
         getty@tty5.service getty@tty6.service motd-news.timer systemd-networkd-wait-online.service \
         fstrim.timer dpkg-db-backup.timer ead.service; do
  systemctl mask "$u" >/dev/null 2>&1 || true
done
ln -sf ../run/systemd/resolve/stub-resolv.conf /etc/resolv.conf
# Firefox from Mozilla's .deb (dependencies are in mkosi.conf).
if [ -f /var/cache/aios-pkgs/firefox.deb ]; then
  dpkg -i /var/cache/aios-pkgs/firefox.deb >/dev/null
  rm -rf /var/cache/aios-pkgs
  mkdir -p /usr/lib/firefox/distribution
  cat > /usr/lib/firefox/distribution/policies.json <<'JSON'
{
  "policies": {
    "DisableAppUpdate": true,
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DontCheckDefaultBrowser": true,
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "SkipTermsOfUse": true,
    "UserMessaging": {"WhatsNew": false, "ExtensionRecommendations": false, "FeatureRecommendations": false, "UrlbarInterventions": false, "SkipOnboarding": true, "MoreFromMozilla": false},
    "Preferences": {
      "browser.tabs.inTitlebar": {"Value": 0, "Status": "locked"}
    }
  }
}
JSON
  # The first-run "Welcome / Terms of Use" sheet is driven by plain prefs that
  # the Preferences policy does not accept, so set them as defaults here.
  mkdir -p /usr/lib/firefox/defaults/pref
  cat > /usr/lib/firefox/defaults/pref/aios.js <<'PREFS'
pref("browser.aboutwelcome.enabled", false);
pref("browser.preonboarding.enabled", false);
pref("termsofuse.bypassNotification", true);
pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
pref("trailhead.firstrun.didSeeAboutWelcome", true);
pref("browser.startup.homepage_override.mstone", "ignore");
PREFS
fi
# /var is a tmpfs at runtime, so keep the font cache under /usr.
fc-cache -s -f >/dev/null 2>&1 || true
CHROOT
