# AiOS window theme: light, calm, matches the shell. labwc 0.7 reads it
# from <theme>/openbox-3/. The close, minimise and
# maximise buttons are macOS-style traffic lights (the *-active.svg and
# *-inactive.svg files next to this one; hover variants show the glyph).
border.width: 1
padding.height: 8
titlebar.height: 30
window.active.border.color: #dcdee6
window.inactive.border.color: #e6e8ee
window.active.title.bg.color: #fbfbfd
window.inactive.title.bg.color: #f4f5f8
window.active.label.text.color: #6b7083
window.inactive.label.text.color: #a4a8b8
window.label.text.justify: center
window.active.button.unpressed.image.color: #6b7083
window.inactive.button.unpressed.image.color: #b0b4c4
menu.items.bg.color: #fbfbfd
menu.items.text.color: #2b2e3a
menu.items.active.bg.color: #eceef4
menu.items.active.text.color: #2b2e3a
osd.bg.color: #fbfbfd
osd.border.color: #dcdee6
osd.label.text.color: #2b2e3a
